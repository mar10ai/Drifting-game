<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CyberDrifter - Complex Drift Circuit</title>
    <!-- Tailwind CSS for UI overlay styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for HUD icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap');

        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #0b0c10;
            font-family: 'Rajdhani', sans-serif;
            color: #fff;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
            background: #0b0c10;
        }

        /* Glassmorphism Styling */
        .glass-panel {
            background: rgba(15, 17, 26, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 243, 255, 0.25);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.7), inset 0 0 15px rgba(0, 243, 255, 0.05);
        }

        .neon-text-cyan {
            color: #00f3ff;
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.6);
        }

        .neon-text-magenta {
            color: #ff007f;
            text-shadow: 0 0 8px rgba(255, 0, 127, 0.6);
        }

        .neon-text-gold {
            color: #ffb703;
            text-shadow: 0 0 8px rgba(255, 183, 3, 0.6);
        }

        /* Animated Drift Popup */
        @keyframes floatUpFade {
            0% { opacity: 0; transform: translateY(10px) scale(0.8); }
            20% { opacity: 1; transform: translateY(0) scale(1.1); }
            80% { opacity: 1; transform: translateY(-10px) scale(1.0); }
            100% { opacity: 0; transform: translateY(-25px) scale(0.9); }
        }

        .combo-pop {
            animation: floatUpFade 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Mobile Touch Controls */
        .touch-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(0, 243, 255, 0.3);
            backdrop-filter: blur(4px);
        }
        .touch-btn:active, .touch-btn.active {
            background: rgba(0, 243, 255, 0.35);
            border-color: #00f3ff;
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.5);
        }
    </style>
</head>
<body class="relative min-h-screen select-none overflow-hidden">

    <!-- GAME CANVAS -->
    <canvas id="gameCanvas"></canvas>

    <!-- TOP HUD OVERLAY -->
    <div id="hud" class="absolute top-0 left-0 w-full p-4 md:p-6 pointer-events-none flex justify-between items-start z-10">
        <!-- Left: Primary Score, Best Score & Multiplier -->
        <div class="flex flex-col gap-2 pointer-events-auto">
            <!-- Score & HighScore -->
            <div class="glass-panel rounded-xl p-3 px-5 flex flex-col gap-1 w-48 md:w-64">
                <div class="flex justify-between items-center text-xs text-gray-400 font-orbitron tracking-wider">
                    <span>SCORE</span>
                    <span class="text-gray-400">BEST: <span id="hudBestScore" class="text-yellow-400 font-bold">0</span></span>
                </div>
                <div id="scoreText" class="font-orbitron text-2xl md:text-3xl font-black neon-text-cyan tracking-wider">0</div>
                
                <!-- Secondary Score Display (Style / Smoke Score) -->
                <div class="flex justify-between items-center text-[10px] text-gray-400 font-orbitron border-t border-gray-800 pt-1 mt-1">
                    <span class="text-pink-400 font-bold"><i class="fa-solid fa-fire-flame-curved mr-1"></i>STYLE SCORE</span>
                    <span id="styleScoreText" class="text-pink-300 font-bold">0 PTS</span>
                </div>
            </div>

            <!-- Drift Multiplier Bar -->
            <div class="glass-panel rounded-xl p-3 px-5 flex flex-col gap-1 w-48 md:w-64">
                <div class="flex justify-between items-center text-xs font-orbitron tracking-wider">
                    <span class="text-gray-400">DRIFT MULTIPLIER</span>
                    <span id="multiplierText" class="font-black neon-text-magenta text-sm">x1.0</span>
                </div>
                <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden p-0.5 border border-gray-700">
